{
  "name": "@qlik/dts-bundler",
  "version": "",
  "description": "Bundle TypeScript declaration files into a single file",
  "keywords": [],
  "license": "ISC",
  "author": "nilzona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlik-oss/dts-bundler.git"
  },
  "bin": {
    "bundle-types": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown src/index.ts --outDir dist --format esm --dts",
    "check-types": "tsc6 --noEmit",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "test:watch": "vitest"
  },
  "dependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@qlik/oxfmt-config": "^0.2.1",
    "@qlik/oxlint-config": "^0.8.2",
    "@qlik/tsconfig": "^1.1.0",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}
